{
  "name": "worldengine-backend",
  "version": "0.2.1",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "predev": "node ../scripts/free-port.mjs 3000",
    "dev": "node --watch --env-file=.env.development server.js",
    "start": "node server.js",
    "db:reset": "node db/reset.js",
    "lint": "eslint .",
    "test": "node --test --test-isolation=process \"tests/{*.test.js,!(e2e)/**/*.test.js}\"",
    "test:coverage": "node --test --test-isolation=process --experimental-test-coverage --test-coverage-exclude=\"../assistant/**\" --test-coverage-exclude=\"tests/**\" \"tests/{*.test.js,!(e2e)/**/*.test.js}\"",
    "test:e2e": "WE_E2E=1 node --test --test-isolation=process \"tests/e2e/*.test.js\""
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "undici": "^8.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0"
  }
}
